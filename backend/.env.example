NODE_ENV=development
PORT=4000

# Neon Console → Connect. Keep sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Neon Console → Auth → Auth URL (public, not a secret)
NEON_AUTH_URL=https://ep-xxxx.neonauth.REGION.aws.neon.tech/neondb/auth

# GitHub → Settings → Developer settings → GitHub Apps → your App
GITHUB_APP_ID=123456
GITHUB_APP_SLUG=your-app-slug
# Secret. base64 -i <app>.private-key.pem | tr -d '\n'
GITHUB_APP_PRIVATE_KEY=

# Secret. openssl rand -hex 32 — same value in the App's webhook settings
GITHUB_WEBHOOK_SECRET=
# Secret. Slack app → Incoming Webhooks → webhook URL (https://hooks.slack.com/services/...)
SLACK_WEBHOOK_URL=

# Dev only: smee.io channel forwarded to localhost by `npm run webhooks` (keep private)
SMEE_URL=https://smee.io/your-channel
# Dev only: make jobs for this event fail transiently to test retries (ignored in production)
# QUEUE_FAIL_EVENT=issues
